# Copy this file to .env.staging.local and fill it with hosted staging values.
# .env.staging.local is ignored by Git.

# Local-only Supabase setup values. These are never synced to Vercel by scripts.
SUPABASE_PROJECT_REF=replace_with_supabase_project_ref
SUPABASE_DB_PASSWORD=replace_with_hosted_database_password

# Vercel runtime values.
NEXT_PUBLIC_APP_URL=https://replace-with-preview-or-staging-domain.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://replace_with_supabase_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_hosted_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_hosted_service_role_key
DATABASE_URL=postgresql://postgres.replace_with_supabase_project_ref:replace_with_encoded_password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Optional integrations until they are activated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EXPO_ACCESS_TOKEN=

{
  "expo": {
    "name": "WIAHost",
    "slug": "wiahost",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wiahost",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f3eadf"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#d7ff5f"
      },
      "package": "com.globaltech.wiahost",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#d7ff5f",
          "defaultChannel": "operations"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "WIAHost necesita la camara para adjuntar evidencias operativas.",
          "photosPermission": "WIAHost necesita acceder a tus fotos para adjuntar evidencias operativas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f634871-2e9e-4d76-bf6b-13fbf872d330"
      }
    }
  }
}

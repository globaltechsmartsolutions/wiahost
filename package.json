{
  "name": "wiahost",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter web exec next dev --port 3002",
    "build": "turbo build",
    "build:web": "pnpm --filter web build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:a11y": "pnpm --filter web test:a11y",
    "test:visual": "pnpm --filter web test:visual",
    "audit:web": "pnpm --filter web audit:web && pnpm test:visual",
    "audit:visual": "pnpm test:visual",
    "audit:lighthouse": "pnpm build:web && pnpm lighthouse",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "format": "prettier --write .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/database/src/database.types.ts"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "chrome-launcher": "^1.2.1",
    "prettier": "latest",
    "supabase": "^2.95.5",
    "turbo": "latest"
  }
}

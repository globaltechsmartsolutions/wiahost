{
  "name": "wiahost",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter web exec next dev --port 3002",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "turbo build",
    "build:web": "pnpm --filter web build",
    "build:mobile": "pnpm --filter mobile build",
    "eas:login": "pnpm --filter mobile exec eas login",
    "eas:whoami": "pnpm --filter mobile exec eas whoami",
    "eas:configure": "pnpm --filter mobile exec eas build:configure",
    "eas:build:android:preview": "pnpm --filter mobile exec eas build --platform android --profile preview",
    "eas:build:android:production": "pnpm --filter mobile exec eas build --platform android --profile production",
    "eas:submit:android:internal": "pnpm --filter mobile exec eas submit --platform android --profile production",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:a11y": "pnpm --filter web test:a11y",
    "test:visual": "pnpm --filter web test:visual",
    "test:visual:update": "pnpm --filter web test:visual:update",
    "quality:routes": "node scripts/audit-route-coverage.mjs",
    "quality:db": "node scripts/audit-database-security.mjs",
    "quality:prod": "node scripts/audit-production-readiness.mjs",
    "quality:prod:production": "node scripts/audit-production-readiness.mjs --mode=production",
    "quality:summary": "node scripts/audit-quality-summary.mjs",
    "quality:ci": "pnpm quality:routes && pnpm quality:db && pnpm quality:prod && pnpm quality:summary",
    "audit:web": "pnpm --filter web audit:web && pnpm test:visual",
    "audit:visual": "pnpm test:visual",
    "audit:lighthouse": "pnpm build:web && pnpm lighthouse",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "format": "prettier --write .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/database/src/database.types.ts"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "chrome-launcher": "^1.2.1",
    "prettier": "latest",
    "supabase": "^2.95.5",
    "turbo": "latest"
  }
}
